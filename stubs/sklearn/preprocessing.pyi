import numpy as np
from numpy.typing import ArrayLike, NDArray

class _Transformer:
    def set_output(self, *, transform: str) -> object: ...
    def transform(self, X: ArrayLike) -> NDArray[np.floating]: ...

class _Invertible(_Transformer):
    def inverse_transform(self, X: ArrayLike) -> NDArray[np.floating]: ...

class StandardScaler(_Invertible):
    def __init__(self, *, with_mean: bool = True, with_std: bool = True) -> None: ...
    def fit(self, X: ArrayLike) -> StandardScaler: ...
    def partial_fit(self, X: ArrayLike) -> StandardScaler: ...

class MinMaxScaler(_Invertible):
    def __init__(
        self, feature_range: tuple[float, float] = (0, 1), *, clip: bool = False
    ) -> None: ...
    def fit(self, X: ArrayLike) -> MinMaxScaler: ...
    def partial_fit(self, X: ArrayLike) -> MinMaxScaler: ...

class MaxAbsScaler(_Invertible):
    def __init__(self) -> None: ...
    def fit(self, X: ArrayLike) -> MaxAbsScaler: ...
    def partial_fit(self, X: ArrayLike) -> MaxAbsScaler: ...

class RobustScaler(_Invertible):
    def __init__(
        self,
        *,
        with_centering: bool = True,
        with_scaling: bool = True,
        quantile_range: tuple[float, float] = (25.0, 75.0),
        unit_variance: bool = False,
    ) -> None: ...
    def fit(self, X: ArrayLike) -> RobustScaler: ...

class Normalizer(_Transformer):
    def __init__(self, norm: str = "l2") -> None: ...
    def fit(self, X: ArrayLike) -> Normalizer: ...

class QuantileTransformer(_Invertible):
    def __init__(
        self,
        *,
        n_quantiles: int = 1000,
        output_distribution: str = "uniform",
        subsample: int | None = 10000,
        random_state: int | None = None,
    ) -> None: ...
    def fit(self, X: ArrayLike) -> QuantileTransformer: ...

class PowerTransformer(_Invertible):
    def __init__(self, method: str = "yeo-johnson", *, standardize: bool = True) -> None: ...
    def fit(self, X: ArrayLike) -> PowerTransformer: ...

class FunctionTransformer(_Invertible):
    def __init__(self) -> None: ...
    def fit(self, X: ArrayLike) -> FunctionTransformer: ...
