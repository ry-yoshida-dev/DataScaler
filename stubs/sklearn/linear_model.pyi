import numpy as np
from numpy.typing import ArrayLike, NDArray

class LogisticRegression:
    def __init__(self) -> None: ...
    def fit(self, X: ArrayLike, y: ArrayLike | None) -> LogisticRegression: ...
    def predict(self, X: ArrayLike) -> NDArray[np.int64]: ...
    def predict_proba(self, X: ArrayLike) -> NDArray[np.floating]: ...
    def score(self, X: ArrayLike, y: ArrayLike) -> float: ...

class Ridge:
    def __init__(self) -> None: ...
    def fit(self, X: ArrayLike, y: ArrayLike | None) -> Ridge: ...
    def predict(self, X: ArrayLike) -> NDArray[np.float64]: ...
    def score(self, X: ArrayLike, y: ArrayLike) -> float: ...
