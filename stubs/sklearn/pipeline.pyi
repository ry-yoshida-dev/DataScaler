import numpy as np
from numpy.typing import ArrayLike, NDArray

class Pipeline[PredictionT: np.generic]:
    named_steps: dict[str, object]

    def __init__(self, steps: list[tuple[str, object]]) -> None: ...
    def set_output(self, *, transform: str) -> object: ...
    def fit(self, X: ArrayLike, y: ArrayLike | None = None) -> Pipeline[PredictionT]: ...
    def predict(self, X: ArrayLike) -> NDArray[PredictionT]: ...
    def transform(self, X: ArrayLike) -> NDArray[np.floating]: ...
    def inverse_transform(self, X: ArrayLike) -> NDArray[np.floating]: ...
